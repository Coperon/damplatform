# Copy to .env.local and fill in real values. Never commit .env.local.
# Next.js reads this file only at startup — restart `npm run dev` after editing.

# ---- database ----
# Local dev: the Docker container on host port 5433.
# Neon: use the POOLED string (the host contains "-pooler") for the app, and
# write sslmode=verify-full explicitly rather than sslmode=require -- pg 8.x
# currently treats "require" as "verify-full", but pg 9 / pg-connection-string 3
# will switch it to libpq semantics, which skip certificate verification. Being
# explicit keeps today's behaviour across that upgrade.
# Run migrations against the DIRECT (non-pooler) string instead; override
# DATABASE_URL for that one command rather than storing it here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dam

# Connection pool, all optional with working defaults (see lib/db.ts).
# PG_POOL_MAX must be 1 on serverless (Vercel): every warm instance holds its
# own pool against the same database. Leave these unset for local dev.
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=10000
# PG_CONNECT_TIMEOUT_MS=10000

# ---- auth ----
# 256-bit random value. Rotating it invalidates every active session.
JWT_SECRET=

# ---- object storage (S3-compatible: MinIO locally, Cloudflare R2 in prod) ----
# Local MinIO:
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1
#
# Cloudflare R2 — S3_REGION MUST be the literal "auto"; anything else is
# rejected. The endpoint is the S3 API one from the R2 bucket settings page,
# NOT a public bucket URL and NOT the dashboard URL:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
# Use an R2 API token scoped to this one bucket with Object Read & Write, not
# an account-wide token.
#
# R2 denies cross-origin requests by default and MinIO allows them, so a bucket
# CORS policy is REQUIRED on R2 or every upload and every thumbnail fails in the
# browser while the server looks healthy. Verify with:
#   node scripts/check-env.mjs --origin=https://your-app-domain
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=damassets

# ---- outbound mail ----
SMTP_USER=
SMTP_PASS=

# ---- public URL ----
# Must be the real public origin in production, never localhost.
# Drives password-reset links and every generated share link.
APP_URL=http://localhost:3000

# ---- share-link encryption ----
# base64-encoded 32-byte AES-256 key.
# WARNING: rotating this makes every existing share link permanently
# undecryptable. Treat as a backed-up secret.
SHARE_TOKEN_KEY=
