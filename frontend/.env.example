# Copy to .env.local and fill in real values. Never commit .env.local.
# Next.js reads this file only at startup — restart `npm run dev` after editing.

# ---- database ----
# Local dev: the Docker container on host port 5433.
# Demo / Vercel: Supabase Postgres. Use the POOLED (transaction pooler)
# connection string for the app — copy it from Connect, do not guess
# aws-0-<region>. This Ireland project is aws-1-eu-west-1, not aws-0.
# Append sslmode=require&uselibpqcompat=true (node pg + Supabase's cert).
# Vercel is IPv4-only: do not use db.<ref>.supabase.co from serverless.
# Run migrations against DIRECT_DATABASE_URL (session pooler :5432 or
# IPv4 add-on), never DDL through the transaction pooler.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# DIRECT_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Connection pool, all optional with working defaults (see lib/db.ts).
# PG_POOL_MAX must be 1 on serverless (Vercel): every warm instance holds its
# own pool against the same database. Leave these unset for local dev.
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=10000
# PG_CONNECT_TIMEOUT_MS=10000

# ---- auth ----
# 256-bit random value. Rotating it invalidates every active session.
JWT_SECRET=

# ---- object storage (S3-compatible) ----
# Local MinIO:
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1
#
# Demo / Vercel: Supabase Storage S3 protocol (same dashboard as Postgres).
# Storage → Configuration → S3. Enable S3, create access keys, then:
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   S3_REGION=<project region, e.g. eu-west-1>
#   S3_ACCESS_KEY / S3_SECRET_KEY = those S3 keys (not the anon/service JWT)
#   S3_BUCKET=damassets   (create a private bucket with this name)
# Path-style addressing is already on in lib/storage.ts (required for Supabase).
# Add a CORS rule on the bucket for the Vercel origin (PUT/GET/HEAD, * headers).
# Verify with: node scripts/check-env.mjs --origin=https://your-app-domain
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=damassets

# ---- outbound mail ----
# Generic SMTP (Resend, SES, Mailgun, …):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=<api key>
#   SMTP_FROM=DAM <noreply@yourdomain>
# Gmail app-password fallback when SMTP_HOST is unset:
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=

# ---- public URL ----
# Must be the real public origin in production, never localhost.
# Drives password-reset links and every generated share link.
APP_URL=http://localhost:3000

# ---- share-link encryption ----
# base64-encoded 32-byte AES-256 key.
# WARNING: rotating this makes every existing share link permanently
# undecryptable. Treat as a backed-up secret.
SHARE_TOKEN_KEY=
